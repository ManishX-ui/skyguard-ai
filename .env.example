# ============================================================================
# SkyGuard AI — Environment Configuration Template
# ============================================================================
# Copy this file to .env and adjust variables as required.
# Never commit actual credentials, secret tokens, or private keys to git.

# Application Environment (development, testing, production)
APP_ENV=development

# Edge Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3101
GATEWAY_DB_PATH=gateway/edge.db

# Frontend Dashboard Configuration
VITE_EDGE_API_URL=http://localhost:3101
VITE_BASE_PATH=/skyguard-ai/

# Alert & Notification Settings (Optional)
ALERT_LOG_PATH=alerts.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Webhook Integration (Optional)
WEBHOOK_URL=
WEBHOOK_AUTH_TOKEN=

# Model & Evaluation Configuration (Optional)
ANOMALY_THRESHOLD=0.50
WARNING_THRESHOLD=0.30
Z_THRESHOLD=2.5
